# VM의 deploy/.env로 복사해 채운다(.env는 커밋 금지). 앱 컨테이너 런타임 시크릿.
# 컨테이너는 todakun-net 네트워크 안에서 서로 컨테이너명으로 통신한다.

# --- 배포 이미지 (GHCR) — 보통 CI(deploy.yaml)가 switch.sh에 주입하므로 여기선 참고용 ---
APP_IMAGE=ghcr.io/<owner>/todakun-app:dev-latest

# --- 서비스 도메인 (은닉용 — 절대 커밋/노출 금지) ---
# 추측 불가능한 랜덤 서브도메인 권장 (예: k9x2m7q3.todakun.com). api-dev 같은 명백한 이름 금지.
# 이 값이 유출되면 은닉은 무의미해진다. Caddy가 이 도메인만 서빙한다.
DOMAIN=

# 보조 도메인 — 같은 오리진이 함께 수신할 도메인(⚠️ 임시, prod 구축 시 제거).
# prod 미구축 상태에서 prod용 도메인을 dev로 흘려보내기 위한 것. 비워두면 미사용(alias.invalid 폴백).
# 빈 값 자체는 안전하나, 값을 넣을 땐 반드시 유효한 호스트명 하나만 넣을 것.
DOMAIN_ALIAS=

# --- Cloud SQL (PostgreSQL) — VM에서 Private IP 또는 Cloud SQL Auth Proxy로 접속 ---
DB_PASSWORD=
DB_URL=jdbc:postgresql://<CLOUD_SQL_PRIVATE_IP>:5432/todakun
DB_USERNAME=todakun

# --- Redis (같은 네트워크의 컨테이너명) ---
REDIS_HOST=todakun-redis
REDIS_PORT=6379

# --- GCP Cloud Storage — VM 서비스 계정 ADC로 인증(자격증명 값 불필요) ---
GCP_PROJECT_ID=
GCS_BUCKET=todakun-bucket

# --- Sentry (APM/에러 추적) — 비우면 자동 비활성 ---
SENTRY_DSN=

# --- Grafana Cloud (Alloy 엣지 에이전트가 metrics/logs 전송) ---
# 값 출처는 monitoring/grafana-cloud/README.md 참고. GC_TOKEN이 유일한 시크릿.
GC_LOKI_URL=
GC_LOKI_USER=
GC_PROM_URL=
GC_PROM_USER=
GC_TOKEN=

# --- Discord ERROR 알림 웹훅 (앱이 logback appender로 직접 발송) — 비우면 자동 비활성 ---
DISCORD_WEBHOOK_URL=
