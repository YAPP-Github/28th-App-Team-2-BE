// =============================================================================
// Grafana Alloy 엣지 에이전트 — todakun
// metrics(host + Spring actuator) → Grafana Cloud Prometheus
// logs(Docker stdout, JSON level) → Grafana Cloud Loki
// 자격증명은 컨테이너 env(GC_*)에서 sys.env()로 주입. (BEAT-SERVER 패턴 참고)
// =============================================================================

logging {
	level  = "info"
	format = "logfmt"
}

// -----------------------------------------------------------------------------
// 1. Host metrics — node_exporter 대체 (Alloy 내장 unix exporter)
// -----------------------------------------------------------------------------
prometheus.exporter.unix "node" {
	rootfs_path        = "/host/rootfs"
	procfs_path        = "/host/proc"
	sysfs_path         = "/host/sys"
	disable_collectors = ["btrfs", "infiniband", "ipvs", "wifi", "zfs"]
}

prometheus.scrape "node" {
	targets         = prometheus.exporter.unix.node.targets
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.cleanup.receiver]
}

// -----------------------------------------------------------------------------
// 2. Spring Boot Actuator — blue/green 정적 target (비활성 color는 up=0으로 처리)
// -----------------------------------------------------------------------------
prometheus.scrape "spring_boot" {
	targets = [
		{ __address__ = "todakun-app-blue:8080", job = "todakun-app", color = "blue" },
		{ __address__ = "todakun-app-green:8080", job = "todakun-app", color = "green" },
	]
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.cleanup.receiver]
}

// -----------------------------------------------------------------------------
// 3. Cardinality 보호 (Grafana Cloud 비용 방어 — 고카디널리티 시리즈/라벨 drop)
// -----------------------------------------------------------------------------
prometheus.relabel "cleanup" {
	rule {
		source_labels = ["__name__"]
		regex         = "jvm_(buffer_pool|memory_pool|classes_unloaded)_.*"
		action        = "drop"
	}
	rule {
		source_labels = ["__name__"]
		regex         = "tomcat_(global|cache|servlet)_.*"
		action        = "drop"
	}
	rule {
		action = "labeldrop"
		regex  = "exception|outcome|instance_name"
	}

	forward_to = [prometheus.remote_write.gc.receiver]
}

// -----------------------------------------------------------------------------
// 4. Remote write → Grafana Cloud Prometheus
// -----------------------------------------------------------------------------
prometheus.remote_write "gc" {
	external_labels = {
		env     = "dev",
		cluster = "todakun-dev",
	}

	endpoint {
		url = sys.env("GC_PROM_URL")
		basic_auth {
			username = sys.env("GC_PROM_USER")
			password = sys.env("GC_TOKEN")
		}
	}
}

// -----------------------------------------------------------------------------
// 5. Docker stdout/stderr → Grafana Cloud Loki
//    라벨 정책: env / cluster / container / level 만 승격 (고카디널리티는 라인 내부 보존)
// -----------------------------------------------------------------------------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host    = "unix:///var/run/docker.sock"
	targets = discovery.relabel.containers.output
	labels  = {
		env     = "dev",
		cluster = "todakun-dev",
	}
	forward_to = [loki.process.enrich.receiver]
}

loki.process "enrich" {
	// logstash 구조화 로그(JSON)에서 level 추출 → 라벨 승격.
	stage.json {
		expressions = {
			level = "level",
		}
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	forward_to = [loki.write.gc.receiver]
}

loki.write "gc" {
	endpoint {
		url = sys.env("GC_LOKI_URL")
		basic_auth {
			username = sys.env("GC_LOKI_USER")
			password = sys.env("GC_TOKEN")
		}
	}
}