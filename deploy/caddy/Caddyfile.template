# switch.sh가 아래 업스트림 플레이스홀더를 활성 color(todakun-app-blue:8080 등)로 치환해
# caddy/Caddyfile로 렌더링한 뒤 `caddy reload` 한다.
#
# 사이트 주소는 {$DOMAIN} env로 주입한다(하드코딩 금지).
#   이유: 도메인 은닉(obscurity)이 성립하려면 도메인명이 git에 커밋되면 안 된다.
#   실제 값(추측 불가능한 랜덤 서브도메인 권장)은 VM의 .env에만 둔다.
#
# TLS: Cloudflare 프록시(orange) + Full(Strict). origin에는 Cloudflare Origin Certificate(와일드카드 *.todakun.com 권장) 사용
#      → Caddy는 ACME를 쓰지 않고, 엣지는 Universal SSL 와일드카드라 특정 서브도메인이 공개 CT 로그에 남지 않는다.
#      인증서 파일은 VM의 caddy/certs/에 배치(커밋 금지) → 컨테이너에 /etc/caddy/certs로 마운트.
# 전제: (1) Cloudflare DNS에 랜덤 서브도메인 레코드 프록시 ON(orange), (2) 도메인명을 어디에도 노출/커밋하지 않음.
#
# {$DOMAIN_ALIAS} — 같은 오리진이 함께 받아줄 보조 도메인(⚠️ 임시 조치, prod 구축 시 제거).
#   배경: prod가 아직 미구축인데 prod용 DNS 레코드가 dev VM을 가리키는 상황. Caddy는 site 주소에
#         없는 Host로 들어온 요청에 "빈 200"을 돌려주므로(reverse_proxy까지 가지 않음) DNS·TLS가
#         멀쩡한데도 앱이 죽은 것처럼 보인다. 여기 나열해야 비로소 정상 응답한다.
#   실제 도메인 값은 {$DOMAIN}과 동일하게 SOPS 시크릿(domain_alias) → VM .env에만 둔다(커밋 금지).
#   TLS: 와일드카드 Origin 인증서가 두 이름을 모두 커버하므로 추가 작업 없음.
#
#   ⚠️ 빈 문자열 금지 — `DOMAIN_ALIAS=`(빈 값)로 주입되면 주소 목록이 `a.com, ` 꼴이 되어
#      "Expected another address but had '{'" 파싱 에러로 Caddy가 아예 뜨지 않는다.
#      그래서 방어를 2중으로 건다:
#        (1) 여기 `:alias.invalid` 기본값 — 컨테이너에 env 자체가 없는 경우(예: compose 재생성 전
#            switch.sh만 도는 경로)를 막는다.
#        (2) compose의 `${DOMAIN_ALIAS:-alias.invalid}` — env가 "빈 값"으로 오는 경우를 막는다.
#      alias.invalid는 RFC 2606 예약 TLD라 절대 해석되지 않으므로 어떤 요청과도 매칭되지 않는다.
{$DOMAIN}, {$DOMAIN_ALIAS:alias.invalid} {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key

	# SSE(text/event-stream)는 압축에서 제외한다.
	#   이유: gzip은 응답을 버퍼링하므로 AI 토큰 스트리밍이 지연/뭉침(chunk 뭉개짐) 된다.
	#   방법: encode 기본 match에서 광범위한 text/*를 세부 subtype으로 풀어쓰고 text/event-stream만 뺀다.
	#         (Caddy encode의 match는 Content-Type OR 매칭 — 나열되지 않은 타입은 압축하지 않는다.)
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
			header Content-Type application/wasm*
		}
	}

	# actuator는 외부 비공개(404). Prometheus 스크레이프/헬스체크는 todakun-net 내부로만 수행되므로 영향 없음.
	handle /actuator/* {
		respond 404
	}

	# 딥링크 검증 파일 — 앱(reverse_proxy)이 아니라 정적 파일로 직접 서빙한다.
	#   /.well-known/assetlinks.json             → Android App Links
	#   /.well-known/apple-app-site-association  → iOS Universal Links
	# 파일은 Ansible(tasks/render_wellknown.yaml)이 SOPS 시크릿에서 렌더링해
	# VM의 caddy/well-known/ 에 배치하고, compose가 /etc/caddy/well-known 으로 :ro 마운트한다.
	#
	# Content-Type을 명시하는 이유: AASA는 규격상 확장자가 없어 Caddy가 MIME을 추론하지 못한다.
	#   text/plain으로 나가면 Apple CDN이 거부한다. 둘 다 JSON이라 블록 전체에 걸어도 안전하다.
	# handle_path는 /.well-known 프리픽스를 벗겨내므로 root 아래에 파일명 그대로 두면 된다.
	# 이 블록이 catch-all handle보다 경로가 구체적이라 Caddy가 먼저 매칭한다(파일 순서 무관).
	# ACME(/.well-known/acme-challenge)는 사용하지 않는다 — Cloudflare Origin 인증서를 쓰므로 충돌 없음.
	handle_path /.well-known/* {
		root * /etc/caddy/well-known
		header Content-Type application/json
		file_server
	}

	handle {
		reverse_proxy __APP_UPSTREAM__ {
			# 액티브 헬스 체크 — 업스트림이 죽으면 자동 배제.
			health_uri /actuator/health
			health_interval 5s
			health_timeout 3s
		}
	}
}
