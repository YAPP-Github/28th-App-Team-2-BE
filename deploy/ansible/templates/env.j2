# Ansible이 SOPS 시크릿에서 렌더링 — 수동 편집 금지(secrets.sops.yaml을 고칠 것).
# 컨테이너(app/caddy/alloy)가 env_file로 읽는다.

# 서비스 도메인 (은닉용 — Caddy {$DOMAIN})
DOMAIN={{ domain }}

# Cloud SQL
DB_URL={{ db_url }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}

# Redis
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}

# GCP Cloud Storage
GCP_PROJECT_ID={{ gcp_project_id }}
GCS_BUCKET={{ gcs_bucket }}

# Vertex AI Gemini (오늘의 운세 생성)
VERTEX_AI_LOCATION={{ vertex_ai_location }}
VERTEX_AI_CHAT_MODEL={{ vertex_ai_chat_model }}

# Sentry
SENTRY_DSN={{ sentry_dsn }}

# Discord ERROR 알림 웹훅 (앱 logback appender가 직접 발송, 비우면 no-op)
DISCORD_WEBHOOK_URL={{ discord_webhook_url | default('') }}

# JWT
JWT_SECRET={{ jwt_secret }}

# Google OAuth
GOOGLE_OAUTH_CLIENT_IDS={{ google_oauth_client_ids }}

# Apple OAuth (Sign In with Apple)
APPLE_CLIENT_IDS={{ apple_client_ids }}
APPLE_TEAM_ID={{ apple_team_id }}
APPLE_KEY_ID={{ apple_key_id }}
APPLE_PRIVATE_KEY={{ apple_private_key }}

# 컬럼 암호화 (Apple refresh token at-rest 암호화, AES-256-GCM)
ENCRYPTION_KEY={{ encryption_key }}

# Grafana Cloud (Alloy)
GC_PROM_URL={{ gc_prom_url }}
GC_PROM_USER={{ gc_prom_user }}
GC_LOKI_URL={{ gc_loki_url }}
GC_LOKI_USER={{ gc_loki_user }}
GC_TOKEN={{ gc_token }}

# CORS (dev/prod 허용 origin)
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins | default('') }}

# Swagger 비밀 경로 (prod에서 /swagger-ui.html 직접 노출 방지)
# ⚠️ prod 프로필(application-prod.yaml)은 기본값 없이 ${SWAGGER_SECRET_PATH}를 참조한다 —
#    prod SOPS(inventory/prod/group_vars/all.sops.yaml)에 반드시 값을 채워야 앱이 기동한다.
#    비워두면(default) 렌더 자체는 되지만 prod 기동이 실패한다.
SWAGGER_SECRET_PATH={{ swagger_secret_path | default('') }}
