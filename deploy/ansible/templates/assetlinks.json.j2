{#
  Android App Links 검증 파일(Digital Asset Links) — /.well-known/assetlinks.json 으로 서빙된다.

  최상위가 "배열"이라 debug/release 두 statement를 한 파일에 담을 수 있다.
  debug 지문은 dev 환경 SOPS에만 두고 prod에는 넣지 않는다 → 운영 도메인에 개발용 서명키 지문 미노출.
  (android_debug_* 가 정의되지 않으면 release statement 하나만 렌더링된다.)

  값은 전부 SOPS(inventory/{env}/group_vars/all.sops.yaml)에서 온다 — 이 템플릿엔 실제 값 하드코딩 금지.

  주석 닫기의 하이픈은 뒤따르는 개행을 제거한다 — 이 템플릿은 trim_blocks=false라
  없으면 JSON 맨 앞에 빈 줄이 붙는다.
-#}
[
  {
    "relation": [
      "delegate_permission/common.handle_all_urls"
    ],
    "target": {
      "namespace": "android_app",
      "package_name": "{{ android_package_name }}",
      "sha256_cert_fingerprints": [
        "{{ android_sha256_fingerprint }}"
      ]
    }
  }{% if android_debug_package_name | default('', true) | length > 0 %},
  {
    "relation": [
      "delegate_permission/common.handle_all_urls"
    ],
    "target": {
      "namespace": "android_app",
      "package_name": "{{ android_debug_package_name }}",
      "sha256_cert_fingerprints": [
        "{{ android_debug_sha256_fingerprint }}"
      ]
    }
  }{% endif %}
]
