# VM .env를 렌더링하는 시크릿 소스 스키마. 환경별 파일로 복사 후 실제 값 채우고 암호화:
#   cd deploy/ansible
#   cp inventory/secrets.sops.yaml.example inventory/dev/group_vars/all/secrets.sops.dev.yaml
#   # 실제 값 채우고 →
#   sops -e -i inventory/dev/group_vars/all/secrets.sops.dev.yaml
# 암호화된 파일만 git에 커밋(암호문이라 안전). 이 .example는 스키마 문서용.
#
# 참고: APP_IMAGE는 시크릿이 아니라 배포 시점 값이므로 여기 없음(deploy.yaml이 switch.sh에 주입).

# GHCR pull 자격증명 (VM docker login용, .env에는 안 들어감 — 컨테이너에 노출 X)
# ghcr_pat = read:packages 스코프의 GitHub PAT.
ghcr_user: "REPLACE"
ghcr_pat: "REPLACE"

# 서비스 도메인 (은닉용 랜덤 서브도메인)
domain: "REPLACE.todakun.com"

# Cloudflare Origin Certificate (와일드카드 *.todakun.com). Ansible이 VM의
# /opt/todakun/caddy/certs/ 로 렌더링 → 수동 배치 불필요. PEM 전체를 그대로 붙여넣는다.
cloudflare_origin_cert: |
  -----BEGIN CERTIFICATE-----
  REPLACE_WITH_ORIGIN_CERT_PEM
  -----END CERTIFICATE-----
cloudflare_origin_key: |
  -----BEGIN PRIVATE KEY-----
  REPLACE_WITH_ORIGIN_PRIVATE_KEY
  -----END PRIVATE KEY-----

# Cloud SQL
db_url: "jdbc:postgresql://<CLOUD_SQL_PRIVATE_IP>:5432/todakun"
db_username: "REPLACE"
db_password: "REPLACE"

# Redis (컨테이너명)
redis_host: "REPLACE"
redis_port: "REPLACE"

# GCP Cloud Storage
gcp_project_id: "REPLACE"
gcs_bucket: "REPLACE"

# Vertex AI Gemini (오늘의 운세 생성) — ADC 인증(GCP Cloud Storage와 동일 프로젝트), 키 파일 불필요
vertex_ai_location: "REPLACE"
vertex_ai_chat_model: "REPLACE"

# Sentry (비우면 no-op)
sentry_dsn: ""

# Discord ERROR 알림 웹훅 (비우면 no-op)
discord_webhook_url: ""

# JWT (HS256 서명 키 — 최소 256비트, 예: openssl rand -base64 32)
jwt_secret: "REPLACE"

# Apple OAuth (Sign In with Apple) — private_key는 .p8을 PKCS8 DER base64로 변환한 값(개행 없음)
apple_client_ids: "REPLACE"
apple_team_id: "REPLACE"
apple_key_id: "REPLACE"
apple_private_key: "REPLACE"

# 컬럼 암호화 (Apple refresh token at-rest 암호화, AES-256-GCM) — 32바이트를 Base64 인코딩한 값, 예: openssl rand -base64 32
encryption_key: "REPLACE"

# 딥링크 검증 파일(App Links / Universal Links). Ansible(tasks/render_wellknown.yaml)이
# templates/{assetlinks.json,apple-app-site-association}.j2 로 렌더링해 VM의
# /opt/todakun/caddy/well-known/ 에 배치 → Caddy가 /.well-known/ 아래로 서빙한다.
#
# android_sha256_fingerprint: 앱 서명 인증서의 SHA-256 지문(대문자 16진수, 콜론 구분).
#   확인: keytool -list -v -keystore <keystore> -alias <alias>
#         또는 Play Console → 설정 → 앱 서명 (Play App Signing 사용 시 반드시 이쪽 지문)
android_package_name: "REPLACE"
android_sha256_fingerprint: "AA:BB:...:ZZ"

# debug 빌드 지문 — dev 인벤토리에만 넣는다(prod에는 넣지 않아 운영 도메인에 개발용 서명키 미노출).
# 두 키는 반드시 쌍으로 넣거나 쌍으로 빼야 한다(한쪽만 있으면 렌더 단계 assert가 실패한다).
android_debug_package_name: "REPLACE.debug"
android_debug_sha256_fingerprint: "AA:BB:...:ZZ"

# iOS Universal Links. appID = "{apple_team_id}.{apple_bundle_id}" 로 조합된다(team_id는 위 값 재사용).
apple_bundle_id: "REPLACE"

# Grafana Cloud (Alloy)
gc_prom_url: "REPLACE"
gc_prom_user: "REPLACE"
gc_loki_url: "REPLACE"
gc_loki_user: "REPLACE"
gc_token: "REPLACE"

# CORS (dev/prod 허용 origin, 콤마 구분)
cors_allowed_origins: "REPLACE"

# Swagger 비밀 경로 (prod에서 /swagger-ui.html 직접 노출 방지) — 환경마다 별개 값 사용
swagger_secret_path: "REPLACE"
