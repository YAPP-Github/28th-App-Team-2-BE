{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git blame*)",
      "Bash(git check-ignore*)",
      "Bash(git fetch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(java -version)",
      "Bash(docker info*)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(git config --global*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin develop*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push --force-with-lease origin develop*)",
      "Bash(rm -rf /*)"
    ]
  },
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "claude-api": "off",
    "claude-in-chrome": "off",
    "dataviz": "off",
    "keybindings-help": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-check.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-format.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-format.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
